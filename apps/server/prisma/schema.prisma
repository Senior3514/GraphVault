// GraphVault sync server — PostgreSQL schema (spec §3).
//
// This schema is the durable backend selected via GRAPHVAULT_STORAGE=postgres.
// In environments without a live database (and without `prisma generate` run),
// the server defaults to the in-memory backend and never imports the generated
// client, so this file is not required to build the default path.
//
// Generate with:  pnpm --filter @graphvault/server prisma:generate
// Migrate with:   pnpm --filter @graphvault/server prisma:migrate

generator client {
  provider = "prisma-client-js"
  output   = "../src/store/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  devices Device[]
  vaults  Vault[]
  tokens  Token[]

  @@map("users")
}

model Device {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  lastSeen  DateTime @default(now()) @map("last_seen")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens Token[]

  @@index([userId])
  @@map("devices")
}

// Opaque bearer tokens; only the SHA-256 hash of the token is stored.
model Token {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  deviceId  String   @map("device_id")
  expiresAt BigInt   @map("expires_at") // unix epoch seconds
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tokens")
}

model Vault {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String
  headRevision Int      @default(0) @map("head_revision")
  createdAt    DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     File[]
  revisions Revision[]

  @@index([userId])
  @@map("vaults")
}

model File {
  id               String   @id @default(uuid())
  vaultId          String   @map("vault_id")
  path             String
  currentVersionId String?  @unique @map("current_version_id")
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  vault          Vault         @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  versions       FileVersion[] @relation("FileVersions")
  currentVersion FileVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@unique([vaultId, path])
  @@index([vaultId])
  @@map("files")
}

model FileVersion {
  id        String   @id @default(uuid())
  fileId    String   @map("file_id")
  hash      String? // null for a tombstone
  size      Int
  mtime     BigInt // unix epoch ms
  deleted   Boolean  @default(false)
  revision  Int // per-vault seq this version was recorded at
  createdAt DateTime @default(now()) @map("created_at")

  file        File  @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  currentFor  File? @relation("CurrentVersion")

  @@index([fileId])
  @@index([revision])
  @@map("file_versions")
}

// One row per accepted change-set step; seq is the per-vault head at that step.
model Revision {
  id        String   @id @default(uuid())
  vaultId   String   @map("vault_id")
  seq       Int
  createdAt DateTime @default(now()) @map("created_at")

  vault Vault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@unique([vaultId, seq])
  @@index([vaultId])
  @@map("revisions")
}

// Content-addressed blob metadata; the bytes live on disk under dataDir.
model Blob {
  hash      String   @id
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blobs")
}

// --- Remote MCP connector: OAuth 2.1 authorization server ------------------
// Lets a remote MCP client (e.g. Claude.ai's "custom connector") register
// itself (RFC 7591 dynamic client registration), run the user through a
// login+consent screen, and exchange a PKCE-verified authorization code for
// short-lived access + refresh tokens - all served by this same self-hosted
// instance, no external identity provider. Secrets are hashed the same way
// the existing auth Token model already does; only the hash is ever persisted.
// Given a full Prisma implementation (unlike some newer per-user config
// tables that still live in a process-lifetime map - see store/prisma.ts),
// since a Claude.ai connector losing its authorization on every server
// restart would defeat the point of a persistent connection.

model OAuthClient {
  id               String   @id @default(uuid())
  clientId         String   @unique @map("client_id")
  // Null for a public client (PKCE-only, no secret) - MCP clients commonly
  // register this way. When present, only the hash is stored.
  clientSecretHash String?  @map("client_secret_hash")
  clientName       String   @map("client_name")
  redirectUris     String[] @map("redirect_uris")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("oauth_clients")
}

// Short-lived, single-use. Consumed atomically at the token endpoint.
model OAuthAuthorizationCode {
  codeHash      String   @id @map("code_hash")
  clientId      String   @map("client_id")
  userId        String   @map("user_id")
  redirectUri   String   @map("redirect_uri")
  codeChallenge String   @map("code_challenge")
  scope         String
  expiresAt     BigInt   @map("expires_at") // unix epoch seconds
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("oauth_authorization_codes")
}

// One row per issued access+refresh token pair; refresh rotates the whole
// row (old row deleted, new one created) so a stolen, already-used refresh
// token is detectable.
model OAuthToken {
  accessTokenHash  String   @id @map("access_token_hash")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  clientId         String   @map("client_id")
  userId           String   @map("user_id")
  scope            String
  accessExpiresAt  BigInt   @map("access_expires_at") // unix epoch seconds
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([clientId])
  @@map("oauth_tokens")
}
